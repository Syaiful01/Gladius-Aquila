# ============================================================
#  GladiusAquila — contoh konfigurasi
#  Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# ============================================================

# --- Telegram (WAJIB untuk mode live) -----------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Identitas agent ----------------------------------------
AGENT_NAME=Gladius Aquila
AGENT_EMOJI=🦅
USER_TITLE=Boss
TIMEZONE=Asia/Jakarta

# --- Jadwal -------------------------------------------------
# Seberapa sering agent memindai pasar (menit)
SCAN_INTERVAL_MINUTES=30
# Seberapa sering laporan rutin dikirim (menit). Alert penting tetap dikirim kapan saja.
REPORT_INTERVAL_MINUTES=240

# --- Sumber data crypto -------------------------------------
# Urutan exchange publik (CCXT). Jika Binance diblokir di region VPS, taruh bybit di depan.
EXCHANGE_PRIORITY=binance,bybit
QUOTE_ASSET=USDT
# Fallback ke CoinGecko (gratis) bila semua exchange gagal
USE_COINGECKO_FALLBACK=true
# Opsional: API key demo CoinGecko (gratis) untuk limit lebih longgar
COINGECKO_API_KEY=
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
# Koin yang tidak ingin dipindai (pisahkan koma), stablecoin sudah otomatis dikecualikan
EXCLUDED_BASES=

# --- Parameter scanner --------------------------------------
# Hanya koin dengan volume 24j >= nilai ini yang dianalisis lebih dalam (USD)
MIN_CANDIDATE_VOLUME_USD=30000000
# Ambang "volume sangat besar" (USD)
HIGH_VOLUME_USD=300000000
# Lonjakan volume candle terakhir vs rata-rata 24 candle sebelumnya
VOLUME_SPIKE_RATIO=2.0
# Batas jumlah koin yang dianalisis per siklus (menjaga rate limit)
MAX_CANDIDATES=40
OHLCV_TIMEFRAME=1h
OHLCV_LIMIT=100
RSI_PERIOD=14
RSI_OVERBOUGHT=75
# Momentum kuat: naik minimal X% dalam 24j, volume recent >= rata-rata * rasio
MOMENTUM_MIN_CHANGE_PCT=5
MOMENTUM_MIN_VOLUME_RATIO=1.2
# Exhaustion: sudah naik >= X% dalam 24j, RSI overbought, volume recent <= rata-rata * rasio
EXHAUSTION_MIN_GAIN_PCT=12
EXHAUSTION_MAX_VOLUME_RATIO=0.7

# --- Berita ekonomi (Gold / XAUUSD) -------------------------
NEWS_ENABLED=true
# Mirror JSON gratis kalender ForexFactory
NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# Cache kalender (menit) — sumber gratis ini membatasi request, jangan terlalu kecil
NEWS_CACHE_MINUTES=60
# Mata uang yang dipantau (pisahkan koma)
NEWS_CURRENCIES=USD
# Peringatan dini: berapa menit sebelum event
NEWS_LOOKAHEAD_MINUTES=60
# Analisis pasca-rilis: berapa menit setelah event masih dianalisis
NEWS_POST_RELEASE_MINUTES=90

# --- Anti-spam alert ----------------------------------------
# Koin + jenis sinyal yang sama tidak dikirim ulang dalam rentang ini (menit)
ALERT_COOLDOWN_MINUTES=180
# Skor minimum sinyal agar dikirim sebagai alert
MIN_ALERT_SCORE=2
MAX_ALERTS_PER_CYCLE=5
# Pesan error ke Telegram dibatasi 1x per konteks dalam rentang ini (menit)
ERROR_COOLDOWN_MINUTES=60

# --- Logging ------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
